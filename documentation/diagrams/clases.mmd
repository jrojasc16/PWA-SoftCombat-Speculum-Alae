%% Diagrama de clases — Monolito modular Flask (MVP)
classDiagram

namespace modules_iam {
    class User {
        +int id
        +str email
        +str password_hash
        +str name
        +int role_id
        +int community_id
        +bool active
        +datetime created_at
    }
    class Role {
        +int id
        +str name
        +JSON permissions
    }
    class AuthService {
        +register_user(email, password, name, community_id)
        +authenticate(email, password)
        +cambiar_estado_usuario(admin_id, user_id, activo)
        +cambiar_rol_usuario(admin_id, user_id, rol)
    }
    class UserRepository
    class RoleRepository
}

namespace modules_combat {
    class Combat {
        <<aggregate root>>
        +int id
        +int community_id
        +int reporter_id
        +int referee_id
        +enum status
        +datetime played_at
        +str client_request_id
        +bool processed
        +datetime created_at
    }
    class CombatParticipant {
        +int id
        +int combat_id
        +int user_id
        +enum result
        +int community_id
    }
    class Confirmation {
        +int id
        +int combat_id
        +int user_id
        +JSON reported_result
        +int community_id
        +datetime created_at
    }
    class AuditLog {
        +int id
        +int combat_id
        +int admin_id
        +str campo
        +str valor_anterior
        +str valor_nuevo
        +int community_id
        +datetime created_at
    }
    class CombatService {
        +report_combat(reporter_id, community_id, participants, played_at)
        +confirm_combat(user_id, combat_id, result)
        +admin_edit_result(admin_id, combat_id, nuevos_datos)
        +listar_combates_admin(community_id, estado)
        +auditoria_de_combate(combat_id, admin_id)
    }
    class CombatRepository
    class ConfirmationRepository
    class AuditLogRepository
}

namespace modules_ranking {
    class EloCalculator {
        <<domain service puro>>
        +expected_score(rating_a, rating_b) float
        +t_factor(combates) float
        +x_factor(percentil) float
        +k_factor(combates, percentil) float
        +new_ratings() DueloResultado
        +resolver_duelo() DueloResultado
    }
    class Rating {
        +int id
        +int user_id
        +int community_id
        +float points
        +int matches_played
        +datetime updated_at
    }
    class RatingHistory {
        +int id
        +int combat_id
        +int user_id
        +int community_id
        +float points_before
        +float points_after
        +int matches_played
        +float k
        +float percentil
        +datetime created_at
    }
    class RankingService {
        +process_confirmed_combat(combat_id)
        +recalculate_full(community_id)
    }
    class RatingRepository
    class RatingHistoryRepository
}

namespace modules_history {
    class HistoryService {
        +historial_de_usuario(user_id, community_id, page, per_page)
    }
    class HistorialRepository
}

namespace modules_public_api {
    class RankingEntryDTO {
        +int position
        +str name
        +float points
        +int matches_played
    }
    class PublicRankingService {
        +ranking_publico(community_id, page, per_page) List~RankingEntryDTO~
    }
}

User "N" --> "1" Role
Combat "1" *-- "N" CombatParticipant
Combat "1" *-- "N" Confirmation
Combat "1" *-- "N" AuditLog
CombatParticipant "N" --> "1" User
Confirmation "N" --> "1" User
Combat --> User : reporter / referee opcional
Rating --> User
RatingHistory --> User
RatingHistory --> Combat

CombatService ..> CombatRepository
CombatService ..> ConfirmationRepository
CombatService ..> AuditLogRepository
CombatService ..> RankingService : notifica confirmación
RankingService ..> EloCalculator
RankingService ..> RatingRepository
RankingService ..> RatingHistoryRepository
HistoryService ..> HistorialRepository
PublicRankingService ..> RatingRepository
AuthService ..> UserRepository
AuthService ..> RoleRepository
