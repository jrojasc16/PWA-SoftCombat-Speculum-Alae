@startuml clases
!theme plain
title Diagrama de clases — Monolito modular Flask (MVP)

package "modules.iam" {
  class User {
    +id: int
    +email: str (único)
    +password_hash: str (bcrypt costo 12)
    +name: str
    +role_id: int
    +community_id: int
    +active: bool
    +created_at: datetime
  }
  class Role {
    +id: int
    +name: str  ' jugador | arbitro | admin | super_admin
    +permissions: JSON  ' preparado para roles dinámicos
  }
  class AuthService {
    +register_user(email, password, name, community_id)
    +authenticate(email, password)
    +cambiar_estado_usuario(admin_id, user_id, activo)
    +cambiar_rol_usuario(admin_id, user_id, rol)
  }
  class UserRepository
  class RoleRepository
}

package "modules.combat" {
  class Combat <<aggregate root>> {
    +id: int
    +community_id: int
    +reporter_id: int
    +referee_id: int (nullable)
    +status: enum  ' PENDIENTE | CONFIRMADO | CONFLICTO | RESUELTO
    +played_at: datetime
    +client_request_id: str  ' idempotencia del reporte (offline)
    +processed: bool  ' idempotencia Elo
    +created_at: datetime
  }
  class CombatParticipant {
    +id: int
    +combat_id: int
    +user_id: int
    +result: enum  ' VICTORIA | DERROTA
    +community_id: int
  }
  class Confirmation {
    +id: int
    +combat_id: int
    +user_id: int
    +reported_result: JSON  ' {"winner_id": n}
    +community_id: int
    +created_at: datetime
  }
  class AuditLog {
    +id: int
    +combat_id: int
    +admin_id: int
    +campo: str
    +valor_anterior: str (nullable)
    +valor_nuevo: str (nullable)
    +community_id: int
    +created_at: datetime
  }
  class CombatService {
    +report_combat(reporter_id, community_id, participants, played_at, ...)
    +confirm_combat(user_id, combat_id, result)
    +admin_edit_result(admin_id, combat_id, nuevos_datos)  ' escribe AuditLog
    +listar_combates_admin(community_id, estado)
    +auditoria_de_combate(combat_id, admin_id)
  }
  class CombatRepository
  class ConfirmationRepository
  class AuditLogRepository
}

package "modules.ranking" {
  class EloCalculator <<domain service, puro>> {
    +expected_score(rating_a, rating_b): float
    +t_factor(combates): float
    +x_factor(percentil): float
    +k_factor(combates, percentil): float
    +new_ratings(...): DueloResultado
    +resolver_duelo(...): DueloResultado
  }
  note right of EloCalculator
    Sin dependencias externas (ni Flask ni SQLAlchemy).
    Constantes k y percentiles según reglamento
    nacional SoftCombat 2021, págs. 13-15.
    Cobertura de tests >= 70%.
  end note
  class Rating {
    +id: int
    +user_id: int
    +community_id: int
    +points: float
    +matches_played: int
    +updated_at: datetime
  }
  class RatingHistory {
    +id: int
    +combat_id: int
    +user_id: int
    +community_id: int
    +points_before: float
    +points_after: float
    +matches_played: int
    +k: float
    +percentil: float
    +created_at: datetime
  }
  class RankingService {
    +process_confirmed_combat(combat_id)  ' misma transacción que la confirmación
    +recalculate_full(community_id)  ' botón admin; reconstruye desde historial
  }
  class RatingRepository
  class RatingHistoryRepository
}

package "modules.history" {
  class HistoryService {
    +historial_de_usuario(user_id, community_id, page, per_page)
  }
  class HistorialRepository
}

package "modules.public_api" {
  class RankingEntryDTO {
    +position: int
    +name: str
    +points: float
    +matches_played: int
  }
  class PublicRankingService {
    +ranking_publico(community_id, page, per_page)  ' caché en memoria, TTL
  }
}

User "N" --> "1" Role
Combat "1" *-- "N" CombatParticipant
Combat "1" *-- "N" Confirmation
Combat "1" *-- "N" AuditLog
CombatParticipant "N" --> "1" User
Confirmation "N" --> "1" User
Combat --> User : reporter / referee (opcional)
Rating --> User
RatingHistory --> User
RatingHistory --> Combat

CombatService ..> CombatRepository
CombatService ..> ConfirmationRepository
CombatService ..> AuditLogRepository
CombatService ..> RankingService : notifica confirmación
RankingService ..> EloCalculator
RankingService ..> RatingRepository
RankingService ..> RatingHistoryRepository
HistoryService ..> HistorialRepository
PublicRankingService ..> RatingRepository
AuthService ..> UserRepository
AuthService ..> RoleRepository

@enduml
